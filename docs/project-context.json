  "pipeline_entity": "lead",
  "pipeline_stages": [
    "S1 Contacto",
    "S2 En conversación",
    "S3 Perfilando",
    "S4 Handoff ready",
    "S5 Handoff enviado",
    "S6 Asesor aceptó",
    "S7 Visita agendada",
    "S8 Visita realizada",
    "S9 Negociación",
    "S10 Cierre",
    "Descartado"
  ],
  "pipeline_rules": {
    "kanban": "Keep the Atomic CRM kanban but retarget it from deal to lead. Single mutually-exclusive stage per lead.",
    "stage_ownership_frontier": "S1-S5 are read-only in the CRM (computed/overwritten by sync). From S6 onward the stage is CRM-owned and the sync MUST NOT overwrite it (guard in sync). S6 is set via a manual CRM button.",
    "transitions": "Stages can be skipped. S7 <-> S8 is bidirectional (multiple visits). Descartado requires motivo_descarte. S10 Cierre is admin-set.",
    "stage_owners": {
      "S1": "auto_bot", "S2": "auto_bot", "S3": "auto_bot", "S4": "auto_bot",
      "S5": "auto_system", "S6": "manual_crm_button", "S7": "manual", "S8": "manual",
      "S9": "manual", "S10": "manual_admin", "Descartado": "manual"
    }
  },
  "user_roles": [
    { "name": "admin", "permissions": ["read_all", "write", "reassign_leads", "global_config", "set_stage_s6_s10", "set_cierre"] },
    { "name": "manager", "permissions": ["read_own_and_team", "write", "reassign_within_team", "set_stage_s6_s10"] },
    { "name": "asesor", "permissions": ["read_own", "set_stage_s6_s10", "write_notes", "write_visits"] }
  ],
  "multi_tenant": true,
  "multi_tenant_notes": "Per-advisor isolation enforced via Supabase RLS (asesor_asignado <-> user), not frontend filters.",
  "integrations": [
    {
      "name": "whatsapp_bot_sheet_sync",
      "type": "custom",
      "direction": "one_way_sheet_to_supabase",
      "frequency": "cron every 1-2 min",
      "synced_tables": ["leads", "propiedades", "conversaciones", "anuncios", "asesores", "nocnok_raw"],
      "rules": [
        "The WhatsApp bot keeps writing to Google Sheets; the Sheet stays the bot's source of truth.",
        "Never sync Supabase -> Sheet. No bidirectionality CRM -> bot.",
        "Stage-ownership frontier: sync computes/overwrites lead.stage only while stage <= S5; once a lead reaches S6 the sync must never overwrite the stage (explicit guard).",
        "Advisor-only data (notas, visitas, motivo_descarte, manual handoff_trigger) is never touched by sync."
      ]
    }
  ],
  "ui": {
    "language": "es",
    "theme": "light",
    "theme_notes": "Light only — advisors use phones in daylight. No dark mode.",
    "palette": { "primary": "#4f46e5", "secondary": "#764ba2", "light": "#667eea" },
    "dashboards": "none for now (post-validation)"
  },
  "auth": {
    "provider": "google_oauth",
    "domain_restriction": "@inmovel.net"
  },
  "cleanup": {
